{
  "name": "whatsapp-ai-bot-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo: bilingual (Hebrew/English) WhatsApp Cloud API assistant for a small clinic, with webhook security, grounded FAQ answers, appointments, handoff and guardrails. Runs on mocks.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/run-eval.ts",
    "demo": "tsx scripts/demo-conversation.ts",
    "simulate": "tsx scripts/simulate-conversation.ts",
    "start:env": "tsx --env-file=.env src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
