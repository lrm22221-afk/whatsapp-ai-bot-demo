# --- WhatsApp Cloud API (Meta) ---
# you type the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# App settings > Basic > App secret (signs webhooks)
WHATSAPP_APP_SECRET=your-meta-app-secret
# permanent System User token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=your-system-user-token
# WhatsApp > API setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# point at a mock server for local tests
GRAPH_BASE_URL=https://graph.facebook.com
GRAPH_API_VERSION=v21.0

# --- Bot ---
PORT=3000
# bearer token for /admin/* endpoints
ADMIN_TOKEN=change-me
# templates approved in WhatsApp Manager
APPROVED_TEMPLATES=appointment_followup,hello_world
# below this retrieval score the bot hands off instead of answering
FAQ_MIN_SCORE=0.4

# --- Optional real models (leave empty for the deterministic offline mode) ---
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
